enum EventStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  CLOSED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
}

type Event {
  id: ID!
  name: String!
  description: String
  startSaleAt: String!
  endSaleAt: String!
  totalStock: Int!
  availableStock: Int!
  price: Float!
  status: EventStatus!
  category: String
  maxPerUser: Int!
  createdAt: String!
  updatedAt: String!
}

type User {
  id: ID!
  name: String!
  email: String!
  role: String!
  createdAt: String!
}

type AuthPayload {
  token: String!
  user: User!
}

type Order {
  id: ID!
  userId: ID!
  eventId: ID!
  quantity: Int!
  totalPrice: Float!
  status: OrderStatus!
  createdAt: String!
  confirmedAt: String
}

type OrderLog {
  id: ID!
  orderId: ID!
  eventType: String!
  payload: String!
  createdAt: String!
}

type QueueStatus {
  eventId: ID!
  userId: ID!
  position: Int!
  totalInQueue: Int!
  isAllowedToPurchase: Boolean!
  estimatedWaitSeconds: Int!
}

input RegisterInput {
  name: String!
  email: String!
  password: String!
  role: String
}

input LoginInput {
  email: String!
  password: String!
}

input UpdateProfileInput {
  name: String!
  email: String!
  password: String
}

input CreateEventInput {
  name: String!
  description: String
  startSaleAt: String!
  endSaleAt: String!
  totalStock: Int!
  price: Float!
  status: EventStatus
  category: String
  maxPerUser: Int
}

input UpdateEventInput {
  name: String!
  description: String
  startSaleAt: String!
  endSaleAt: String!
  totalStock: Int!
  price: Float!
  status: EventStatus!
  category: String
  maxPerUser: Int!
}

type Query {
  healthCheck: String!
  me: User
  events(status: EventStatus): [Event!]!
  event(id: ID!): Event
  myOrders: [Order!]!
  order(id: ID!): Order
  orders(eventId: ID): [Order!]!
  orderLogs(orderId: ID!): [OrderLog!]!

  # 🎟️ Cek status nomor antrian user saat ini
  getQueueStatus(eventId: ID!): QueueStatus!
}

type Mutation {
  register(input: RegisterInput!): AuthPayload!
  login(input: LoginInput!): AuthPayload!
  updateProfile(input: UpdateProfileInput!): User!
  createEvent(input: CreateEventInput!): Event!
  updateEvent(id: ID!, input: UpdateEventInput!): Event!
  purchaseTicket(eventId: ID!, quantity: Int!): Order!

  # 🎟️ User bergabung ke ruang antrian
  joinWaitingRoom(eventId: ID!): QueueStatus!

  # 🎟️ Admin / Cron meloloskan N user dari antrian ke checkout
  admitUsers(eventId: ID!, batchSize: Int!): [ID!]!
}

type Subscription {
  stockUpdated(eventId: ID!): Event!
  orderStatusChanged(orderId: ID!): Order!
}